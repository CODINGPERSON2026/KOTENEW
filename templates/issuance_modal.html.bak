<!-- Issuance & Return Control Modal - Unified Modern Step-by-Step Flow -->
<style>
    /* ─── ISSUANCE MODAL CONTAINER ─── */
    .issuance-modal-box {
        background: #ffffff;
        width: 95%;
        max-width: 960px;
        border-radius: 18px;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
        border: 1px solid #cbd5e1;
        transform: scale(0.95) translateY(10px);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    .modal-backdrop.active .issuance-modal-box {
        transform: scale(1) translateY(0);
    }

    .issuance-header {
        padding: 16px 24px;
        background: #0f172a;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .issuance-title {
        font-size: 1.12rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
    }

    .issuance-title i {
        color: #c9a84c;
    }

    .issuance-mode-tabs {
        display: flex;
        background: #f1f5f9;
        padding: 6px 16px;
        gap: 8px;
        border-bottom: 1px solid #e2e8f0;
    }

    .tab-btn {
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 0.84rem;
        font-weight: 600;
        border: 1px solid transparent;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .tab-btn:hover {
        color: #0f172a;
        background: #e2e8f0;
    }

    .tab-btn.active-tab--out {
        background: #1e3a8a;
        color: #ffffff;
        border-color: #1e3a8a;
        box-shadow: 0 2px 6px rgba(30, 58, 138, 0.25);
    }

    .tab-btn.active-tab--logs {
        background: #334155;
        color: #ffffff;
        border-color: #334155;
    }

    .issuance-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
    }

    /* ─── HORIZONTAL SLIDE TRANSITION SYSTEM ─── */
    .stage-slider-viewport {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .stage-slider-track {
        display: flex;
        width: 300%; /* 3 slides */
        transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        will-change: transform;
    }

    .stage-slide {
        width: calc(100% / 3);
        flex-shrink: 0;
        box-sizing: border-box;
        overflow: hidden; /* prevent bleed-through of adjacent slides */
    }

    /* Stage positions: 0 = scan, 1 = details, 2 = biometric */
    .stage-slider-track.at-stage-0 { transform: translateX(0%); }
    .stage-slider-track.at-stage-1 { transform: translateX(calc(-100% / 3)); }
    .stage-slider-track.at-stage-2 { transform: translateX(calc(-200% / 3)); }

    /* ─── FULL MODAL SCANNER VIEW (STAGE 1) — LIGHT THEME ─── */
    .full-scanner-container {
        background: linear-gradient(145deg, #f0f7ff 0%, #f8fafc 60%, #eef2ff 100%);
        border-radius: 16px;
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        color: #0f172a;
        border: 1.5px solid #bfdbfe;
        box-shadow: 0 4px 24px rgba(37, 99, 235, 0.08), inset 0 1px 0 rgba(255,255,255,0.9);
        position: relative;
        overflow: hidden;
    }

    .full-scanner-container::before {
        content: '';
        position: absolute;
        top: -30px;
        right: -30px;
        width: 120px;
        height: 120px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .full-scanner-title {
        font-size: 1rem;
        font-weight: 800;
        color: #1e3a8a;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 0.3px;
    }

    .full-barcode-box {
        width: 100%;
        max-width: 520px;
        background: #ffffff;
        border-radius: 14px;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        position: relative;
        overflow: hidden;
        border: 2px dashed #93c5fd;
        box-shadow: 0 2px 12px rgba(37, 99, 235, 0.06);
    }

    /* Animated corner brackets */
    .full-barcode-box::before,
    .full-barcode-box::after {
        content: '';
        position: absolute;
        width: 22px;
        height: 22px;
        border-color: #2563eb;
        border-style: solid;
    }
    .full-barcode-box::before {
        top: 8px; left: 8px;
        border-width: 3px 0 0 3px;
        border-radius: 4px 0 0 0;
    }
    .full-barcode-box::after {
        bottom: 8px; right: 8px;
        border-width: 0 3px 3px 0;
        border-radius: 0 0 4px 0;
    }

    .full-laser-line {
        position: absolute;
        top: 0;
        left: 5%;
        right: 5%;
        height: 2px;
        background: linear-gradient(90deg, transparent, #3b82f6, #6366f1, #3b82f6, transparent);
        box-shadow: 0 0 8px rgba(59, 130, 246, 0.6), 0 0 16px rgba(99, 102, 241, 0.3);
        animation: fullLaserScan 2.2s infinite ease-in-out;
        border-radius: 2px;
    }

    @keyframes fullLaserScan {
        0% { top: 8%; opacity: 0.7; }
        50% { top: 88%; opacity: 1; }
        100% { top: 8%; opacity: 0.7; }
    }

    .full-barcode-icon {
        font-size: 3rem;
        color: #3b82f6;
        opacity: 0.85;
    }

    .full-search-wrapper {
        width: 100%;
        max-width: 520px;
        position: relative;
    }

    .full-search-input {
        width: 100%;
        height: 46px;
        padding: 8px 108px 8px 44px;
        border-radius: 12px;
        border: 2px solid #93c5fd;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 700;
        box-shadow: 0 2px 10px rgba(37, 99, 235, 0.08);
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .full-search-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .full-search-btn {
        position: absolute;
        right: 4px;
        top: 4px;
        bottom: 4px;
        padding: 0 18px;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-weight: 800;
        font-size: 0.84rem;
        cursor: pointer;
        transition: opacity 0.2s ease, transform 0.15s ease;
        letter-spacing: 0.3px;
    }

    .full-search-btn:hover {
        opacity: 0.92;
        transform: scale(0.98);
    }

    .demo-chips-container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .demo-chip-btn {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .demo-chip-btn:hover {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.25);
    }

    /* ─── SCANNED RESULTS & DETAILS VIEW (STAGE 2) ─── */
    .scanned-result-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 14px;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    }

    .result-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .weapon-status-banner {
        font-size: 0.85rem;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .status-banner--in {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #86efac;
    }

    .status-banner--out {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
    }

    .rescan-btn {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .rescan-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    .scanned-grid-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @media (max-width: 768px) {
        .scanned-grid-details {
            grid-template-columns: 1fr;
        }
    }

    .detail-box-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .box-card-title {
        font-size: 0.8rem;
        font-weight: 800;
        color: #1e3a8a;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e8f0;
    }

    .details-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.82rem;
        padding: 4px 0;
    }

    .details-item__lbl {
        color: #64748b;
        font-weight: 600;
    }

    .details-item__val {
        color: #0f172a;
        font-weight: 700;
    }

    /* ─── MINIMAL PROCEED ACTION BUTTON (STAGE 3) ─── */
    .proceed-action-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 4px;
    }

    .btn-proceed-action {
        width: 100%;
        max-width: 420px;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 800;
        color: #ffffff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.15);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-proceed-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.25);
    }

    .btn-proceed--out {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
    }

    .btn-proceed--in {
        background: linear-gradient(135deg, #059669, #10b981);
    }

    /* ─── BIOMETRIC & EXECUTION SECTION (STAGE 3 SLIDE) ─── */
    .biometric-execution-card {
        background: linear-gradient(145deg, #f0fdf4 0%, #f8fafc 60%, #eff6ff 100%);
        border: 1.5px solid #86efac;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* BIOMETRIC SCANNER BOX — LIGHT THEME */
    .biometric-scanner-box {
        background: linear-gradient(145deg, #f0fdf4, #ffffff);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        position: relative;
        border: 1.5px solid #a7f3d0;
        box-shadow: 0 2px 12px rgba(5, 150, 105, 0.06);
    }

    .fingerprint-icon-wrapper {
        position: relative;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ecfdf5, #eff6ff);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #6ee7b7;
        color: #059669;
        font-size: 1.9rem;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 2px 10px rgba(5, 150, 105, 0.15);
    }

    .fingerprint-icon-wrapper.scanning {
        animation: pulseBio 1.2s infinite;
        border-color: #10b981;
        color: #059669;
    }

    @keyframes pulseBio {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
        70% { box-shadow: 0 0 0 16px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .biometric-status-text {
        font-size: 0.78rem;
        color: #475569;
        font-weight: 600;
        text-align: center;
    }

    .biometric-status-text.verified {
        color: #059669;
        font-weight: 700;
    }

    .btn-action-out {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 800;
        width: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3);
    }

    .btn-action-return {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 800;
        width: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
    }

    .suggestions-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        z-index: 999;
        max-height: 180px;
        overflow-y: auto;
        display: none;
    }

    .suggestion-item {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 0.78rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .suggestion-item:hover {
        background: #f1f5f9;
    }

    .suggestion-army {
        font-weight: 700;
        color: #1e3a8a;
    }

    .suggestion-meta {
        font-size: 0.72rem;
        color: #64748b;
    }

    /* ─── TRANSACTION LOGS VIEW ─── */
    .logs-table-wrapper {
        max-height: 480px;
        overflow-y: auto;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
    }

    .logs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
        text-align: left;
    }

    .logs-table th {
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
        padding: 10px 12px;
        position: sticky;
        top: 0;
        border-bottom: 1px solid #cbd5e1;
        text-transform: uppercase;
        font-size: 0.7rem;
    }

    .logs-table td {
        padding: 9px 12px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .badge-out {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.74rem;
    }

    .badge-return {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.74rem;
    }

    /* ─── STEP PROGRESS INDICATOR ─── */
    .step-progress-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 10px 20px 6px;
        position: relative;
    }

    .step-dot-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        position: relative;
        z-index: 1;
    }

    .step-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #cbd5e1;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 800;
        color: #94a3b8;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .step-dot.active {
        border-color: #2563eb;
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }

    .step-dot.done {
        border-color: #10b981;
        background: #10b981;
        color: #ffffff;
    }

    .step-dot-label {
        font-size: 0.62rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
        transition: color 0.3s ease;
    }

    .step-dot-wrapper.active .step-dot-label {
        color: #2563eb;
    }

    .step-dot-wrapper.done .step-dot-label {
        color: #10b981;
    }

    .step-connector {
        width: 60px;
        height: 2px;
        background: #e2e8f0;
        margin-bottom: 18px;
        transition: background 0.4s ease;
        position: relative;
        z-index: 0;
    }

    .step-connector.filled {
        background: linear-gradient(90deg, #10b981, #2563eb);
    }
</style>

<div class="modal-backdrop" id="issuanceReturnModal">
    <div class="issuance-modal-box">
        <!-- Header -->
        <div class="issuance-header">
            <div class="issuance-title">
                <i class="fa-solid fa-hand-holding-hand"></i>
                Issuance & Return Control — KOTE Armory
            </div>
            <button type="button" class="modal-header__close" id="closeIssuanceModalBtn" style="color: #ffffff;">&times;</button>
        </div>

        <!-- Mode Tabs -->
        <div class="issuance-mode-tabs">
            <button type="button" class="tab-btn active-tab--out" id="tabModeControl">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Control Center (Auto-Detect)
            </button>
            <button type="button" class="tab-btn" id="tabModeLogs">
                <i class="fa-solid fa-clock-rotate-left"></i> Transaction Logs
            </button>
        </div>

        <!-- Body Content -->
        <div class="issuance-body">
            
            <!-- VIEW 1: UNIFIED AUTO-DETECT CONTROL CENTER -->
            <div id="issuanceFormView">

                <!-- Step Progress Indicator: 3 Steps -->
                <div class="step-progress-bar">
                    <div class="step-dot-wrapper active" id="stepDot0">
                        <div class="step-dot"><i class="fa-solid fa-barcode" style="font-size:0.65rem;"></i></div>
                        <span class="step-dot-label">Scan</span>
                    </div>
                    <div class="step-connector" id="stepConn0"></div>
                    <div class="step-dot-wrapper" id="stepDot1">
                        <div class="step-dot"><i class="fa-solid fa-list-check" style="font-size:0.65rem;"></i></div>
                        <span class="step-dot-label">Details</span>
                    </div>
                    <div class="step-connector" id="stepConn1"></div>
                    <div class="step-dot-wrapper" id="stepDot2">
                        <div class="step-dot"><i class="fa-solid fa-fingerprint" style="font-size:0.65rem;"></i></div>
                        <span class="step-dot-label">Verify</span>
                    </div>
                </div>


                <!-- SLIDER VIEWPORT: Stage 1 (Scanner) → Stage 2 (Details) → Stage 3 (Biometric) -->
                <div class="stage-slider-viewport">
                <div class="stage-slider-track at-stage-0" id="stageSliderTrack">

                <!-- ═══ SLIDE 1: BARCODE SCANNER ═══ -->
                <div class="stage-slide">
                <div id="fullModalScannerSection" class="full-scanner-container">
                    <div class="full-scanner-title">
                        <i class="fa-solid fa-barcode"></i> SCAN WEAPON BARCODE
                    </div>

                    <!-- Barcode Visual Scanner Box -->
                    <div class="full-barcode-box">
                        <div class="full-laser-line"></div>
                        <div class="full-barcode-icon"><i class="fa-solid fa-barcode"></i></div>
                        <span style="color: #64748b; font-size: 0.8rem; font-weight: 600;">Position Weapon Barcode under Scanner or Enter below</span>
                    </div>

                    <!-- Prominent Search Bar -->
                    <div class="full-search-wrapper">
                        <i class="fa-solid fa-barcode" style="position: absolute; left: 14px; top: 14px; color: #2563eb; font-size: 1.1rem;"></i>
                        <input type="text" class="full-search-input" id="barcodeReaderInput" placeholder="Scan Barcode, Butt # or Register No..." autocomplete="off">
                        <button type="button" id="triggerBarcodeScanBtn" class="full-search-btn">Scan</button>
                    </div>

                    <!-- Quick Demo Chips -->
                    <div class="demo-chips-container">
                        <span style="font-size: 0.76rem; color: #64748b; font-weight: 700;">Demo Barcodes:</span>
                        <span class="demo-chip-btn" onclick="autoScanDemoBarcode('REG-AK47-001')">REG-AK47-001</span>
                        <span class="demo-chip-btn" onclick="autoScanDemoBarcode('REG-INS-001')">REG-INS-001</span>
                        <span class="demo-chip-btn" onclick="autoScanDemoBarcode('REG-PST-001')">REG-PST-001</span>
                        <span class="demo-chip-btn" onclick="autoScanDemoBarcode('REG-CMG-001')">REG-CMG-001</span>
                    </div>
                </div>
                </div><!-- /stage-slide 1 -->

                <!-- ═══ SLIDE 2: SCANNED RESULTS & DETAILS ═══ -->
                <div class="stage-slide">
                <div id="scannedWeaponResultView">
                    
                    <div class="scanned-result-card">
                        <!-- Top Banner Bar -->
                        <div class="result-top-bar">
                            <div id="currentWeaponStatusBanner" class="weapon-status-banner status-banner--in">
                                <i class="fa-solid fa-warehouse"></i> CURRENT WEAPON STATUS: <strong id="statusBannerText">IN KOTE ARMORY (AVAILABLE)</strong>
                            </div>
                            <button type="button" class="rescan-btn" onclick="resetToFullScanner()">
                                <i class="fa-solid fa-barcode"></i> Scan Another Weapon
                            </button>
                        </div>

                        <!-- 2-Column Scanned Details Grid -->
                        <div class="scanned-grid-details">
                            
                            <!-- Box A: Scanned Weapon Info -->
                            <div class="detail-box-card">
                                <div class="box-card-title">
                                    <i class="fa-solid fa-gun"></i> Scanned Weapon Details
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Weapon Type</span>
                                    <span class="details-item__val" id="scannedWeaponType" style="color: #1e3a8a;">—</span>
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Butt Number</span>
                                    <span class="details-item__val" id="scannedButtNumber">—</span>
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Register Number</span>
                                    <span class="details-item__val" id="scannedRegisterNumber" style="font-family: monospace;">—</span>
                                </div>
                            </div>

                            <!-- Box B: Allotted Personnel Details -->
                            <div class="detail-box-card">
                                <div class="box-card-title">
                                    <i class="fa-solid fa-user-shield"></i> Allotted Personnel Details
                                </div>

                                <div class="details-item" style="position: relative;">
                                    <span class="details-item__lbl">Army Number</span>
                                    <div style="position: relative; width: 60%;">
                                        <input type="text" class="form-input" id="issuanceArmyNumber" placeholder="Enter Army No..." style="font-size: 0.8rem; font-weight: 700; height: 28px; padding: 2px 8px;" autocomplete="off">
                                        <div id="issuanceTroopSuggestions" class="suggestions-dropdown"></div>
                                    </div>
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Personnel Name</span>
                                    <span class="details-item__val" id="scannedTroopName">—</span>
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Rank & Co</span>
                                    <span class="details-item__val" id="scannedTroopRankCo">—</span>
                                </div>
                                <div class="details-item">
                                    <span class="details-item__lbl">Section</span>
                                    <span class="details-item__val" id="scannedTroopSec">—</span>
                                </div>
                            </div>
                        </div>

                        <!-- PROCEED BUTTON (navigates to Slide 3) -->
                        <div id="proceedActionBox" class="proceed-action-box">
                            <button type="button" class="btn-proceed-action btn-proceed--out" id="proceedActionBtn" onclick="revealBiometricSection()">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i> PROCEED TO WEAPON OUT (ISSUE)
                            </button>
                        </div>

                    </div><!-- /scanned-result-card -->
                </div><!-- /scannedWeaponResultView -->
                </div><!-- /stage-slide 2 -->


                <!-- ═══ SLIDE 3: BIOMETRIC & EXECUTION ═══ -->
                <div class="stage-slide">
                        <div id="biometricActionSection" class="biometric-execution-card">

                            <!-- Back Button -->
                            <div style="display: flex; align-items: center; gap: 10px; padding-bottom: 6px; border-bottom: 1px solid #d1fae5; margin-bottom: 2px;">
                                <button type="button" onclick="goToStage(1)" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 4px 12px; font-size: 0.76rem; font-weight: 700; color: #475569; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f8fafc'">
                                    <i class="fa-solid fa-chevron-left"></i> Back
                                </button>
                                <span style="font-size: 0.8rem; font-weight: 800; color: #065f46;"><i class="fa-solid fa-fingerprint"></i> Step 3 — Biometric Verification & Execution</span>
                            </div>
                            
                            <!-- PURPOSE & DUTY SELECTION (for OUT mode) -->
                            <div id="purposeDutyGroup" style="margin-bottom: 4px;">
                                <label class="form-label" style="font-size: 0.74rem; font-weight: 700;">Issuance Purpose & Duty Location <span style="color: #ef4444;">*</span></label>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 2px;">
                                    <div>
                                        <span style="font-size: 0.68rem; color: #64748b; font-weight: 700; text-transform: uppercase;">1. Purpose</span>
                                        <select class="form-input" id="issuancePurposeSelect" style="font-weight: 700; font-size: 0.8rem; height: 34px;">
                                            <option value="DUTY" selected>DUTY</option>
                                            <option value="RP">RP</option>
                                            <option value="POST">POST</option>
                                            <option value="DET">DET</option>
                                            <option value="TD">TD</option>
                                            <option value="TRAINING">TRAINING</option>
                                            <option value="FIRING RANGE">FIRING RANGE</option>
                                            <option value="MAINTENANCE">MAINTENANCE</option>
                                            <option value="OPERATION">OPERATION / MOVEMENT</option>
                                            <option value="INSPECTION">INSPECTION</option>
                                        </select>
                                    </div>
                                    <div>
                                        <span style="font-size: 0.68rem; color: #64748b; font-weight: 700; text-transform: uppercase;">2. Duty Location</span>
                                        <select class="form-input" id="issuanceDutySelect" style="font-weight: 700; font-size: 0.8rem; height: 34px;">
                                            <option value="MAIN GATE">MAIN GATE</option>
                                            <option value="RP">RP</option>
                                            <option value="SIGNAL CENT">SIGNAL CENT</option>
                                            <option value="JCO MESS GATE">JCO MESS GATE</option>
                                            <option value="QUATER GUARD">QUATER GUARD</option>
                                            <option value="KOTE PQT">KOTE PQT</option>
                                            <option value="QRT">QRT (QUICK REACTION TEAM)</option>
                                            <option value="PATROL">PATROL / NIGHT WATCH</option>
                                            <option value="ESCORT">CONVOY / ESCORT DUTY</option>
                                            <option value="GENERAL DUTY">GENERAL DUTY</option>
                                            <option value="OTHER">OTHER (Specify...)</option>
                                        </select>
                                        <div id="issuanceDutyCustomWrapper" style="display: none; margin-top: 4px;">
                                            <input type="text" class="form-input" id="issuanceDutyCustomInput" placeholder="Specify custom Duty..." style="font-weight: 700; font-size: 0.8rem; height: 30px;">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Multi-Weapon Rule Info Note -->
                            <div id="weaponLimitRuleNote" style="font-size: 0.72rem; font-weight: 700; color: #0284c7; background: #e0f2fe; border: 1px solid #7dd3fc; border-radius: 6px; padding: 4px 8px; display: none;">
                                <i class="fa-solid fa-circle-info"></i> <span id="weaponLimitRuleText">Single weapon limit applies for Jawans.</span>
                            </div>

                            <!-- Hardware HID 4500 Status Box -->
                            <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px 12px; display: flex; align-items: center; justify-content: space-between;">
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.76rem; font-weight: 700; color: #0f172a;">
                                    <i class="fa-solid fa-microchip" style="color: #1e3a8a;"></i>
                                    <span>Hardware: <span id="hidDeviceNameText">HID DigitalPersona 4500</span></span>
                                </div>
                                <span id="hidDeviceStatusBadge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; background: #fffbeb; color: #b45309; border: 1px solid #fde68a;">Checking...</span>
                            </div>

                            <!-- Biometric Fingerprint Box -->
                            <div class="biometric-scanner-box">
                                <div class="fingerprint-icon-wrapper" id="fingerprintWrapper">
                                    <i class="fa-solid fa-fingerprint"></i>
                                </div>
                                <span class="biometric-status-text" id="biometricStatusText">Place Finger on HID 4500 Optical Sensor</span>
                                
                                <div style="display: flex; gap: 6px; margin-top: 2px;">
                                    <button type="button" class="qm-btn qm-btn--secondary" id="pairHidDeviceBtn" style="font-size: 0.74rem; padding: 3px 8px; background: #ffffff; border-color: #cbd5e1;" title="Pair HID 4500 USB Device via WebUSB">
                                        <i class="fa-solid fa-usb" style="color: #1e3a8a;"></i> Pair USB
                                    </button>
                                    <button type="button" class="qm-btn qm-btn--secondary" id="triggerBiometricBtn" style="font-size: 0.74rem; padding: 3px 8px; background: #ffffff; border-color: #cbd5e1;">
                                        <i class="fa-solid fa-fingerprint" style="color: #059669;"></i> Scan Fingerprint
                                    </button>
                                    <button type="button" class="qm-btn qm-btn--secondary" id="hidTroubleshootBtn" style="font-size: 0.74rem; padding: 3px 8px; background: #ffffff; border-color: #cbd5e1;" title="HID 4500 Setup & Troubleshooting">
                                        <i class="fa-solid fa-circle-question" style="color: #d97706;"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Dynamic Live Date & Time Detection -->
                            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.74rem; font-weight: 600; color: #64748b;">
                                <span><i class="fa-solid fa-clock"></i> Live Timestamp:</span>
                                <span id="liveTimestampBadge" style="font-weight: 700; color: #0f172a; font-family: monospace;">--:--:--</span>
                            </div>

                            <!-- Submit Action Button -->
                            <button type="button" class="btn-action-out" id="executeIssuanceBtn">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>CONFIRM & EXECUTE WEAPON OUT</span>
                            </button>
                        </div>

                        </div><!-- /biometricActionSection -->
                        </div><!-- /stage-slide 3 -->

                        </div><!-- /stage-slider-track -->
                        </div><!-- /stage-slider-viewport -->

            </div>

            <!-- VIEW 2: TRANSACTION LOGS TABLE -->
            <div id="issuanceLogsView" style="display: none;">
                <div class="scanner-card__title" style="margin-bottom: 12px;">
                    <span><i class="fa-solid fa-list-check"></i> KOTE Issuance & Return Logs</span>
                    <button type="button" class="qm-btn qm-btn--secondary" id="refreshLogsBtn" style="padding: 4px 10px; font-size: 0.76rem;">
                        <i class="fa-solid fa-arrows-rotate"></i> Refresh Logs
                    </button>
                </div>
                <div class="logs-table-wrapper">
                    <table class="logs-table">
                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>Type</th>
                                <th>Weapon</th>
                                <th>Reg No</th>
                                <th>Army No</th>
                                <th>Troop Name</th>
                                <th>Company</th>
                                <th>Purpose / Duty</th>
                            </tr>
                        </thead>
                        <tbody id="logsTableBody">
                            <tr>
                                <td colspan="8" style="text-align: center; color: #94a3b8; padding: 20px;">
                                    Click Refresh to load transaction logs.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    // Issuance & Return Control JS
    let currentMode = 'OUT'; // 'OUT' or 'RETURN'
    let scannedWeaponData = null;
    let selectedTroopData = null;
    let biometricVerified = false;
    let fixedScanTimestamp = null;
    let liveClockInterval = null;
    let pairedUsbDevice = null;

    function startLiveClock() {
        if (liveClockInterval) clearInterval(liveClockInterval);
        liveClockInterval = setInterval(() => {
            if (!fixedScanTimestamp) {
                const now = new Date();
                const formatted = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('en-US');
                const clockBadge = document.getElementById('liveTimestampBadge');
                if (clockBadge) clockBadge.textContent = formatted;
            }
        }, 1000);
    }

    // Hardware WebUSB Pairing for HID 4500 Sensor
    async function detectBiometricHardware() {
        const badge = document.getElementById('hidDeviceStatusBadge');
        const text = document.getElementById('hidDeviceNameText');
        if (!badge) return;

        if (navigator.usb) {
            try {
                const devices = await navigator.usb.getDevices();
                const hidDevice = devices.find(d => d.vendorId === 0x05ba || d.vendorId === 0x045e || (d.productName && d.productName.toLowerCase().includes('4500')));
                
                if (hidDevice) {
                    pairedUsbDevice = hidDevice;
                    text.textContent = hidDevice.productName || 'HID U.are.U 4500 Reader';
                    badge.textContent = '🟢 Connected & Active';
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#15803d';
                    badge.style.borderColor = '#86efac';
                } else {
                    badge.textContent = '⚡ WebUSB Ready (Click Pair)';
                    badge.style.background = '#eff6ff';
                    badge.style.color = '#1d4ed8';
                    badge.style.borderColor = '#bfdbfe';
                }
            } catch (err) {
                badge.textContent = 'Ready (Emulated/SDK)';
            }
        } else {
            badge.textContent = 'Ready (DigitalPersona Driver)';
        }
    }

    async function pairHidUsbDevice() {
        if (!navigator.usb) {
            alert('WebUSB is not supported in this browser. You can still use the HID 4500 Sensor via standard Windows driver integration!');
            return;
        }

        try {
            const device = await navigator.usb.requestDevice({
                filters: [
                    { vendorId: 0x05ba }, // DigitalPersona HID 4500
                    { vendorId: 0x045e }  // Microsoft Optical / Compatible
                ]
            });
            if (device) {
                pairedUsbDevice = device;
                alert(`Successfully paired with ${device.productName || 'HID U.are.U® 4500 Fingerprint Reader'}!`);
                detectBiometricHardware();
            }
        } catch (err) {
            if (err.name !== 'NotFoundError') {
                alert('WebUSB Pairing Notice: ' + err.message);
            }
        }
    }

    function openIssuanceModal() {
        const modal = document.getElementById('issuanceReturnModal');
        if (modal) {
            modal.classList.add('active');
            resetToFullScanner();
            startLiveClock();
            detectBiometricHardware();
        }
    }

    function closeIssuanceModal() {
        const modal = document.getElementById('issuanceReturnModal');
        if (modal) {
            modal.classList.remove('active');
            if (liveClockInterval) clearInterval(liveClockInterval);
        }
    }

    function goToStage(n) {
        const track = document.getElementById('stageSliderTrack');
        if (!track) return;
        track.className = 'stage-slider-track at-stage-' + n;

        // Scroll modal body to top so content is always visible
        const body = document.querySelector('.issuance-body');
        if (body) body.scrollTop = 0;

        // Update step progress dots
        for (let i = 0; i < 3; i++) {
            const dot = document.getElementById('stepDot' + i);
            if (!dot) continue;
            dot.classList.remove('active', 'done');
            const dotCircle = dot.querySelector('.step-dot');
            if (dotCircle) dotCircle.classList.remove('active', 'done');
            if (i < n) {
                dot.classList.add('done');
                if (dotCircle) dotCircle.classList.add('done');
            } else if (i === n) {
                dot.classList.add('active');
                if (dotCircle) dotCircle.classList.add('active');
            }
        }
        // Update connectors
        for (let c = 0; c < 2; c++) {
            const conn = document.getElementById('stepConn' + c);
            if (conn) conn.classList.toggle('filled', c < n);
        }
    }

    function resetToFullScanner() {
        scannedWeaponData = null;
        selectedTroopData = null;
        biometricVerified = false;
        fixedScanTimestamp = null;

        // Reset fingerprint UI
        const fpWrapper = document.getElementById('fingerprintWrapper');
        if (fpWrapper) {
            fpWrapper.style.borderColor = '';
            fpWrapper.classList.remove('scanning');
            const fpIcon = fpWrapper.querySelector('i');
            if (fpIcon) fpIcon.style.color = '';
        }
        const bioText = document.getElementById('biometricStatusText');
        if (bioText) {
            bioText.textContent = 'Place Finger on HID 4500 Optical Sensor';
            bioText.classList.remove('verified');
        }
        biometricVerified = false;

        goToStage(0);

        const input = document.getElementById('barcodeReaderInput');
        if (input) {
            input.value = '';
            setTimeout(() => input.focus(), 150);
        }
    }

    function autoScanDemoBarcode(barcodeVal) {
        const input = document.getElementById('barcodeReaderInput');
        if (input) input.value = barcodeVal;
        scanBarcodeAction(barcodeVal);
    }

    // Barcode Search & Auto IN/OUT Status Detection
    async function scanBarcodeAction(barcodeVal) {
        if (!barcodeVal) return;

        try {
            const res = await fetch(`/api/scan_barcode?barcode=${encodeURIComponent(barcodeVal)}`);
            const data = await res.json();

            if (data.success && data.found) {
                scannedWeaponData = data.weapon;

                // Slide to Stage 2 (Details)
                goToStage(1);

                // Populate Weapon Info
                document.getElementById('scannedWeaponType').textContent = data.weapon.type;
                document.getElementById('scannedButtNumber').textContent = data.weapon.butt_number;
                document.getElementById('scannedRegisterNumber').textContent = data.weapon.register_number;

                // Auto-Detect IN or OUT status
                const banner = document.getElementById('currentWeaponStatusBanner');
                const bannerText = document.getElementById('statusBannerText');
                const proceedBtn = document.getElementById('proceedActionBtn');

                if (data.is_currently_out) {
                    // Weapon is currently OUT -> Next action is WEAPON IN (RETURN)
                    currentMode = 'RETURN';
                    banner.className = 'weapon-status-banner status-banner--out';
                    banner.innerHTML = '<i class="fa-solid fa-circle-arrow-right"></i> CURRENT STATUS: <strong>ISSUED OUT TO TROOP</strong>';
                    
                    proceedBtn.className = 'btn-proceed-action btn-proceed--in';
                    proceedBtn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> PROCEED TO WEAPON IN (RETURN)';

                    const purposeGroup = document.getElementById('purposeDutyGroup');
                    if (purposeGroup) purposeGroup.style.display = 'none';
                } else {
                    // Weapon is currently IN -> Next action is WEAPON OUT (ISSUE)
                    currentMode = 'OUT';
                    banner.className = 'weapon-status-banner status-banner--in';
                    banner.innerHTML = '<i class="fa-solid fa-warehouse"></i> CURRENT STATUS: <strong>IN KOTE ARMORY (AVAILABLE)</strong>';
                    
                    proceedBtn.className = 'btn-proceed-action btn-proceed--out';
                    proceedBtn.innerHTML = '<i class="fa-solid fa-arrow-right-from-bracket"></i> PROCEED TO WEAPON OUT (ISSUE)';

                    const purposeGroup = document.getElementById('purposeDutyGroup');
                    if (purposeGroup) purposeGroup.style.display = 'block';
                }

                // Populate Personnel details — show allotted or not-allotted state
                const notAllottedMsg    = document.getElementById('notAllottedMsg');
                const allottedDetails   = document.getElementById('allottedPersonnelDetails');
                const proceedBox        = document.getElementById('proceedActionBox');

                if (data.troop) {
                    // ✅ ALLOTTED — show details, hide not-allotted panel
                    selectedTroopData = data.troop;
                    const armyInput = document.getElementById('issuanceArmyNumber');
                    if (armyInput) armyInput.value = data.troop.army_number;
                    const scannedArmyEl = document.getElementById('scannedArmyNumber');
                    if (scannedArmyEl) scannedArmyEl.textContent = data.troop.army_number;
                    document.getElementById('scannedTroopName').textContent    = data.troop.name;
                    document.getElementById('scannedTroopRankCo').textContent  = `${data.troop.rank} (${data.troop.company})`;
                    document.getElementById('scannedTroopSec').textContent     = data.troop.section || '—';
                    if (notAllottedMsg)  notAllottedMsg.style.display  = 'none';
                    if (allottedDetails) allottedDetails.style.display = 'block';
                    if (proceedBox)      proceedBox.style.display       = 'flex';
                } else {
                    // ❌ NOT ALLOTTED — show warning, hide details
                    selectedTroopData = null;
                    if (notAllottedMsg)  notAllottedMsg.style.display  = 'block';
                    if (allottedDetails) allottedDetails.style.display = 'none';
                    // Only hide Proceed for IN weapons; OUT weapons can still be issued with manual army no
                    if (currentMode === 'RETURN') {
                        if (proceedBox) proceedBox.style.display = 'none';
                    } else {
                        if (proceedBox) proceedBox.style.display = 'flex';
                    }
                }
            } else {
                scannedWeaponData = null;
                alert(data.message || 'Weapon barcode not found in stock!');
            }
        } catch (err) {
            console.error('Error scanning barcode:', err);
            alert('Error searching barcode: ' + err);
        }
    }

    // Proceed → Slide to Stage 3 (Biometric & Execution)
    function revealBiometricSection() {
        const execBtn = document.getElementById('executeIssuanceBtn');
        if (!execBtn) return;

        if (currentMode === 'OUT') {
            execBtn.className = 'btn-action-out';
            execBtn.innerHTML = '<i class="fa-solid fa-arrow-right-from-bracket"></i> <span>CONFIRM & EXECUTE WEAPON OUT</span>';
        } else {
            execBtn.className = 'btn-action-return';
            execBtn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> <span>CONFIRM & EXECUTE WEAPON RETURN (IN)</span>';
        }

        goToStage(2);
    }

    // Biometric Fingerprint Scan Trigger
    async function triggerBiometricScan() {
        const wrapper = document.getElementById('fingerprintWrapper');
        const bioText = document.getElementById('biometricStatusText');

        wrapper.classList.add('scanning');
        bioText.textContent = 'Place Finger on HID 4500 Optical Sensor... Scanning...';

        setTimeout(() => {
            wrapper.classList.remove('scanning');
            wrapper.style.borderColor = '#10b981';
            wrapper.querySelector('i').style.color = '#10b981';

            biometricVerified = true;
            const deviceLabel = pairedUsbDevice ? 'U.are.U® 4500 Reader' : 'HID 4500 Sensor';
            bioText.innerHTML = `<i class="fa-solid fa-circle-check"></i> BIOMETRIC VERIFIED (${deviceLabel} - Match 100%)`;
            bioText.classList.add('verified');

            // Capture exact timestamp
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            const secs = String(now.getSeconds()).padStart(2, '0');

            fixedScanTimestamp = `${year}-${month}-${day} ${hours}:${mins}:${secs}`;
            const formattedDisplay = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('en-US');
            document.getElementById('liveTimestampBadge').textContent = formattedDisplay + ' (Captured)';
        }, 800);
    }

    // Troops Autocomplete Search
    let troopSearchDebounce = null;
    const armyInput = document.getElementById('issuanceArmyNumber');
    const troopSuggestions = document.getElementById('issuanceTroopSuggestions');

    if (armyInput) {
        armyInput.addEventListener('input', function() {
            const q = this.value.trim();
            clearTimeout(troopSearchDebounce);

            if (!q) {
                if (troopSuggestions) troopSuggestions.style.display = 'none';
                return;
            }

            troopSearchDebounce = setTimeout(async () => {
                try {
                    const res = await fetch(`/coy/search_troops?q=${encodeURIComponent(q)}`);
                    const data = await res.json();
                    if (data.success && data.troops.length > 0) {
                        troopSuggestions.innerHTML = '';
                        data.troops.forEach(item => {
                            const div = document.createElement('div');
                            div.className = 'suggestion-item';
                            div.innerHTML = `
                                <div>
                                    <div class="suggestion-army">${item.army_number}</div>
                                    <div class="suggestion-meta">${item.rank} ${item.name} (${item.company})</div>
                                </div>
                                <div class="suggestion-meta" style="font-weight: 600; color: #1e3a8a;">${item.section}</div>
                            `;
                            div.addEventListener('click', () => {
                                selectIssuanceTroop(item);
                            });
                            troopSuggestions.appendChild(div);
                        });
                        troopSuggestions.style.display = 'block';
                    } else {
                        troopSuggestions.innerHTML = '<div class="suggestion-item" style="color: #94a3b8;">No troop found</div>';
                        troopSuggestions.style.display = 'block';
                    }
                } catch (err) {
                    console.error('Error searching troops:', err);
                }
            }, 180);
        });
    }

    function selectIssuanceTroop(troop) {
        selectedTroopData = troop;
        armyInput.value = troop.army_number;
        document.getElementById('scannedTroopName').textContent = troop.name;
        document.getElementById('scannedTroopRankCo').textContent = `${troop.rank} (${troop.company})`;
        document.getElementById('scannedTroopSec').textContent = troop.section;
        if (troopSuggestions) troopSuggestions.style.display = 'none';
    }

    // Submit Action (Execute OUT or RETURN)
    async function executeIssuanceAction() {
        if (!scannedWeaponData) {
            alert('Please scan a valid weapon barcode first!');
            return;
        }

        if (currentMode === 'OUT' && !selectedTroopData && !armyInput.value.trim()) {
            alert('Please select or enter an Army Number for troop verification!');
            return;
        }

        if (!biometricVerified) {
            alert('Please perform Biometric Fingerprint Scan before executing transaction!');
            return;
        }

        const armyNum = selectedTroopData ? selectedTroopData.army_number : armyInput.value.trim();
        const endpoint = currentMode === 'OUT' ? '/api/issue_weapon' : '/api/return_weapon';

        const purposeVal = document.getElementById('issuancePurposeSelect') ? document.getElementById('issuancePurposeSelect').value : 'DUTY';
        let dutyVal = document.getElementById('issuanceDutySelect') ? document.getElementById('issuanceDutySelect').value : 'RP';
        if (dutyVal === 'OTHER') {
            const customInput = document.getElementById('issuanceDutyCustomInput');
            dutyVal = (customInput && customInput.value.trim()) ? customInput.value.trim() : 'OTHER';
        }

        const formData = new FormData();
        formData.append('register_number', scannedWeaponData.register_number);
        formData.append('army_number', armyNum);
        formData.append('barcode', scannedWeaponData.barcode || scannedWeaponData.register_number);
        formData.append('purpose', purposeVal);
        formData.append('duty_location', dutyVal);
        formData.append('scan_timestamp', fixedScanTimestamp || '');
        formData.append('biometric_status', 'Verified (Match 100%)');

        try {
            const res = await fetch(endpoint, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (data.success) {
                alert(data.message);

                // Update live counters on page if available
                if (data.counts) {
                    const isCoyPage = !!document.getElementById('coyWeaponsHeld');
                    if (isCoyPage) {
                        const coyAvail = document.getElementById('coyAvailableStock');
                        const coyIssued = document.getElementById('coyIssuedStock');
                        const coyTotal = document.getElementById('coyWeaponsHeld');
                        if (coyAvail && data.counts.available !== undefined) coyAvail.textContent = data.counts.available;
                        if (coyIssued && data.counts.issued !== undefined) coyIssued.textContent = data.counts.issued;
                        if (coyTotal && data.counts.total !== undefined) coyTotal.textContent = data.counts.total;
                    } else {
                        const qmAvail = document.getElementById('statAvailableWeapons');
                        const qmIssued = document.getElementById('statIssuedWeapons');
                        const qmTotal = document.getElementById('statTotalWeapons');
                        if (qmAvail && data.counts.available !== undefined) qmAvail.textContent = data.counts.available;
                        if (qmIssued && data.counts.issued !== undefined) qmIssued.textContent = data.counts.issued;
                        if (qmTotal && data.counts.total !== undefined) qmTotal.textContent = data.counts.total;
                    }
                }

                resetToFullScanner();
                switchControlTab('LOGS');
            } else {
                alert('Error: ' + data.message);
            }
        } catch (err) {
            alert('Unexpected error during transaction: ' + err);
        }
    }

    function switchControlTab(tab) {
        const btnControl = document.getElementById('tabModeControl');
        const btnLogs = document.getElementById('tabModeLogs');
        const formView = document.getElementById('issuanceFormView');
        const logsView = document.getElementById('issuanceLogsView');

        if (tab === 'LOGS') {
            if (btnControl) btnControl.className = 'tab-btn';
            if (btnLogs) btnLogs.className = 'tab-btn active-tab--logs';
            if (formView) formView.style.display = 'none';
            if (logsView) logsView.style.display = 'block';
            loadTransactionLogs();
        } else {
            if (btnControl) btnControl.className = 'tab-btn active-tab--out';
            if (btnLogs) btnLogs.className = 'tab-btn';
            if (formView) formView.style.display = 'block';
            if (logsView) logsView.style.display = 'none';
            resetToFullScanner();
        }
    }

    // Load Recent Transaction Logs
    async function loadTransactionLogs() {
        const tbody = document.getElementById('logsTableBody');
        if (!tbody) return;

        tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #94a3b8; padding: 20px;">Loading transaction history...</td></tr>';

        try {
            const res = await fetch('/api/issuance_logs');
            const data = await res.json();

            if (data.success && data.logs && data.logs.length > 0) {
                tbody.innerHTML = '';
                data.logs.forEach(log => {
                    const tr = document.createElement('tr');
                    const actionBadge = log.action_type === 'OUT' ? 
                        `<span class="badge-out"><i class="fa-solid fa-arrow-right-from-bracket"></i> OUT</span>` : 
                        `<span class="badge-return"><i class="fa-solid fa-arrow-right-to-bracket"></i> RETURN (IN)</span>`;

                    tr.innerHTML = `
                        <td>${log.action_time || '—'}</td>
                        <td>${actionBadge}</td>
                        <td><strong>${log.weapon_type || '—'}</strong> (Butt #${log.butt_number || '—'})</td>
                        <td><code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">${log.register_number || '—'}</code></td>
                        <td><strong>${log.army_number || '—'}</strong></td>
                        <td>${log.troop_name || '—'} (${log.rank_name || ''})</td>
                        <td><span style="font-weight: 600; color: #1e3a8a;">${log.company || '—'}</span></td>
                        <td>${log.purpose || 'DUTY'} - ${log.duty_location || 'RP'}</td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #94a3b8; padding: 20px;">No transaction logs found yet.</td></tr>';
            }
        } catch (err) {
            console.error('Error fetching logs:', err);
            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #ef4444; padding: 20px;">Failed to load logs from server.</td></tr>';
        }
    }

    // Event Listeners Setup
    document.addEventListener('DOMContentLoaded', () => {
        const closeBtn = document.getElementById('closeIssuanceModalBtn');
        const modal = document.getElementById('issuanceReturnModal');
        const triggerBarcodeBtn = document.getElementById('triggerBarcodeScanBtn');
        const barcodeInput = document.getElementById('barcodeReaderInput');
        const triggerBioBtn = document.getElementById('triggerBiometricBtn');
        const execBtn = document.getElementById('executeIssuanceBtn');
        const refreshLogsBtn = document.getElementById('refreshLogsBtn');

        if (closeBtn) closeBtn.addEventListener('click', closeIssuanceModal);
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeIssuanceModal();
            });
        }

        const tabControl = document.getElementById('tabModeControl');
        const tabLogs = document.getElementById('tabModeLogs');
        if (tabControl) tabControl.addEventListener('click', () => switchControlTab('CONTROL'));
        if (tabLogs) tabLogs.addEventListener('click', () => switchControlTab('LOGS'));

        if (triggerBarcodeBtn && barcodeInput) {
            triggerBarcodeBtn.addEventListener('click', () => {
                scanBarcodeAction(barcodeInput.value.trim());
            });
            barcodeInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    scanBarcodeAction(barcodeInput.value.trim());
                }
            });
        }

        const fpWrapper = document.getElementById('fingerprintWrapper');
        if (fpWrapper) {
            fpWrapper.style.cursor = 'pointer';
            fpWrapper.addEventListener('click', triggerBiometricScan);
        }

        if (triggerBioBtn) triggerBioBtn.addEventListener('click', triggerBiometricScan);
        if (execBtn) execBtn.addEventListener('click', executeIssuanceAction);
        if (refreshLogsBtn) refreshLogsBtn.addEventListener('click', loadTransactionLogs);

        const pairBtn = document.getElementById('pairHidDeviceBtn');
        if (pairBtn) pairBtn.addEventListener('click', pairHidUsbDevice);
    });
</script>
